{
  "name": "nj-watch-team",
  "version": "0.1.4",
  "description": "Medidor de tareas laborales (con consentimiento) — qué apps se usan, cuánto tiempo y qué conviene automatizar. Sin contenido tecleado ni credenciales.",
  "author": "DropoutCapital",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "active-win": "^7.7.2",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "cl.dropout.njwatchteam",
    "productName": "NJ Watch Team",
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/active-win/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "DropoutCapital",
        "repo": "nj-watch-team",
        "releaseType": "release"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": "universal"
        }
      ],
      "artifactName": "NJ-Watch-Team.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "NJ-Watch-Team-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
